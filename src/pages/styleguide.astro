---
// Design system and templates. Not linked from the navigation, not indexed.
import Site from '../layouts/Site.astro';
import TriggerChart from '../components/site/TriggerChart.astro';
import PipelineFlow from '../components/site/PipelineFlow.astro';
import Audience from '../components/site/Audience.astro';
import PocCard from '../components/site/PocCard.astro';
import LivingMark from '../components/site/LivingMark.astro';
import Logo from '../components/Logo.astro';
import { getPocs } from '../lib/pocs';
const pocs = getPocs();

const colours = [
    ['--ground', 'Page background'], ['--surface', 'Panels, cards, report sheets'], ['--line', 'Hairlines, non-paying bars'], ['--ink', 'Text, wordmark, button fill'],
    ['--muted', 'Secondary text, captions, axes'], ['--index', 'Index, thresholds, links, focus'], ['--trigger', 'Triggers and payouts only'], ['--ink-on-trigger', 'Text on a trigger fill'],
];
const templates = [
    ['Home', '/', 'Hero with live chart, audience switch, service ladder, showcase, method, proof, pricing'],
    ['Service page', '/calculation-agent', 'Page head, two run services, method flow, sample report with living mark, FAQ'],
    ['Service page (short)', '/trigger-audit', 'Page head, four checks, example finding with chart, timeline'],
    ['Calculation report', '/showcase/mayotte-coral-bleaching', 'Generated from POC data: fields, metrics, chart, ladder, caveats, sources'],
    ['Index of reports', '/showcase', 'Card grid and comparison table'],
    ['Method', '/method', 'Flow and numbered rules'],
    ['Pricing', '/pricing', 'Offer table, what each line includes, terms'],
    ['Scope form', '/scope', 'Peril, region, data, deadline; composes a mailto with a copy fallback'],
    ['French home', '/fr', 'Same system, French copy'],
];
---

<Site title="Design system · Skaraz Data" description="Tokens, components and page templates for skarazdata.com." noindex>
    <section class="ph panel on-panel">
        <div class="wrap">
            <p class="label">Internal · design system v1.1 (Night ocean, Daylight steel)</p>
            <h1>Templates and components</h1>
            <p class="lede" style="color:var(--panel-muted)">Everything the site is built from. A new calculation report appears automatically when a POC is added to <code>src/lib/pocs.ts</code>.</p>
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Page templates</p><h2>Open any template</h2></div>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Template</th><th>Example</th><th>Built from</th></tr></thead>
                    <tbody>{templates.map(t => <tr><td><strong>{t[0]}</strong></td><td><a class="link" href={t[1]}>{t[1]}</a></td><td>{t[2]}</td></tr>)}</tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Colour</p><h2>Ground, ink, one index colour, one trigger colour</h2><p class="muted">Amber is reserved for triggers, thresholds and payouts. Nothing decorative uses it.</p></div>
            <div class="swatches">
                {colours.map(c => <div class="sw"><span class="chip-c" style={`background:var(${c[0]})`}></span><span class="num small">{c[0]}</span><span class="muted small">{c[1]}</span></div>)}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="wrap type">
            <div class="section-head"><p class="label label--index">Type</p><h2>Switzer 400 and 500, IBM Plex Mono for data</h2></div>
            <p class="h1">Display · The index your policy pays on</p>
            <p class="h2">Heading · Event report, 2019</p>
            <p class="h3">Title · La Réunion, west coast</p>
            <p class="lede">Lead · Defined for the wording, built on public satellite data, checked against real losses.</p>
            <p>Body · Every figure traced to input hashes and code version. A rerun gives the same answer.</p>
            <p class="label">Label · mono, uppercase, tracked</p>
            <p class="num">Figures · 3.40 / 6.80 / 10.20 °C-weeks → 25 / 60 / 100%</p>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Controls</p><h2>Buttons, links, chips</h2></div>
            <div class="row">
                <a class="btn" href="#">Primary <span class="arrow" aria-hidden="true">→</span></a>
                <a class="btn btn--ghost" href="#">Ghost</a>
                <a class="link" href="#">Text link <span class="arrow" aria-hidden="true">→</span></a>
                <span class="chip">backtest scored</span>
                <span class="chip chip--trigger">tier 3</span>
                <span class="chip chip--plain">not scored</span>
            </div>
            <div class="panel on-panel row pad">
                <a class="btn" href="#">Primary on panel</a>
                <a class="btn btn--ghost" href="#">Ghost on panel</a>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Report blocks</p><h2>Fields, metrics, tables, cards</h2></div>
            <div class="grid cols-2">
                <dl class="fields">
                    <dt>Index</dt><dd>Degree Heating Weeks</dd>
                    <dt>Source</dt><dd>NOAA Coral Reef Watch 5 km</dd>
                    <dt>Ladder</dt><dd class="num">3.0 / 6.0 / 9.0 → 25 / 60 / 100%</dd>
                </dl>
                <div class="grid cols-2">
                    <div class="metric"><span class="label">Hit rate</span><span class="value">100%</span><span class="note">16 seasons</span></div>
                    <div class="metric"><span class="label">Cells triggered</span><span class="value">73 / 269</span><span class="note">10 km hexagons</span></div>
                </div>
            </div>
            <div class="card" style="margin-top:28px"><p class="label">Card</p><h3>One element that needs setting apart</h3><p class="muted">Cards are used by role, not everywhere.</p></div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Chart</p><h2>Index against trigger, any POC series</h2><p class="muted">Draws in once on view. Hover or tap to read a value and the tier reached.</p></div>
            <div class="grid cols-2">
                <TriggerChart series={pocs[3].series} height={240} />
                <TriggerChart series={pocs[4].series} height={240} />
            </div>
            <div class="panel pad" style="margin-top:28px;border-radius:10px"><TriggerChart series={pocs[2].series} variant="panel" height={240} /></div>
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Logo and living mark</p><h2>Pixel Horizon, and a mark generated from each POC</h2></div>
            <div class="row" style="align-items:flex-start;gap:48px">
                <div style="width:240px"><Logo /></div>
                <div style="width:72px"><Logo variant="mark" /></div>
                {pocs.filter(p => p.mark).map(p => <LivingMark mark={p.mark!} size={120} />)}
            </div>
        </div>
    </section>
    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Method flow</p><h2>Six steps, light and dark</h2></div>
            <PipelineFlow />
            <div class="panel pad" style="margin-top:28px;border-radius:10px"><PipelineFlow variant="panel" /></div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Audience switch</p><h2>Tabs with sliding indicator</h2></div>
            <Audience />
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head"><p class="label label--index">Showcase card</p><h2>Generated from each POC</h2></div>
            <div class="grid cols-3">{pocs.slice(0, 3).map(p => <PocCard poc={p} />)}</div>
        </div>
    </section>
</Site>

<style>
    .ph { padding-block: 64px; }
    .ph .wrap { display: grid; gap: 16px; }
    .ph code { font-family: var(--mono); color: var(--panel-index); }
    .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }
    .sw { display: grid; gap: 6px; }
    .chip-c { display: block; height: 72px; border-radius: var(--radius); border: 1px solid var(--line); }
    .type { display: grid; gap: 18px; }
    .row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
    .pad { padding: 24px; margin-top: 20px; }
</style>
