---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';

const plans = [
    { t: 'Trigger audit', p: 'EUR 6,000', u: 'fixed, 2 weeks', inc: ['Independent rebuild of the index', 'Backtest over the full record', 'Basis-risk and data-source findings', 'Wording-to-code check', 'Written report, code and walkthrough call'], href: '/trigger-audit', hl: true },
    { t: 'Verifying agent', p: 'from EUR 6,000', u: 'per year, per programme', inc: ['Shadow calculation each event', 'Written reconciliation if results differ', 'Ready to take over as backup', 'Season-end note'], href: '/calculation-agent' },
    { t: 'Binding calculation agent', p: 'from EUR 12,000', u: 'per year, per programme', inc: ['Monitoring through the risk season', 'Two event calculations included', 'Payout reports and audit trail', 'Season-end report', 'Onboarding from EUR 8,000, once'], href: '/calculation-agent' },
];
const more = [
    ['Additional event calculation', 'EUR 1,500 to 3,000', 'Beyond the two included, depending on cells and data'],
    ['Pipeline build', 'EUR 25,000 to 50,000', '8 to 16 weeks, hosted or handed over'],
    ['Data and upkeep retainer', 'EUR 2,000 to 4,000 / month', '6 to 12 months, curated series, refresh and checks'],
    ['Day rate (tenders, advisory)', 'EUR 1,000 / day', 'Remote, English or French'],
];
---

<Site
    title="Pricing · Skaraz Data"
    description="Published prices for parametric trigger audits, calculation agent roles, pipeline builds and climate data retainers."
>
    <PageHead
        label="Pricing"
        title="Published prices, so you can budget before we talk."
        lede="Prices in euros. Final scope is fixed in writing before any work starts."
    />

    <section class="section">
        <div class="wrap">
            <div class="grid cols-3 plans">
                {plans.map((pl, i) => (
                    <div class:list={['plan', 'reveal', { hl: pl.hl }]} style={`--i:${i}`}>
                        {pl.hl && <span class="chip chip--trigger badge">Where most clients start</span>}
                        <h3>{pl.t}</h3>
                        <p class="amount"><span class="num">{pl.p}</span><span class="muted small">{pl.u}</span></p>
                        <ul>{pl.inc.map(x => <li>{x}</li>)}</ul>
                        <a class="link" href={pl.href}>Details <span class="arrow" aria-hidden="true">→</span></a>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal"><p class="label label--index">Everything else</p><h2>Builds, data and day rate.</h2></div>
            <div class="table-wrap reveal">
                <table class="data">
                    <thead><tr><th>Line</th><th>Price</th><th>Scope</th></tr></thead>
                    <tbody>{more.map(r => <tr><td><strong>{r[0]}</strong></td><td class="num">{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
                </table>
            </div>
            <p class="muted small fine">Fees never depend on whether a trigger fires or on the payout amount. Shipped code carries a 30-day guarantee.</p>
        </div>
    </section>
</Site>

<style>
    .plans { align-items: stretch; }
    .plan { position: relative; display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 16px; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
    .plan.hl { border-color: var(--ink); box-shadow: 0 1px 0 var(--ink); }
    .badge { justify-self: start; }
    .amount { display: grid; gap: 4px; }
    .amount .num { font: 600 2rem/1 var(--display); letter-spacing: -0.02em; }
    .plan ul { list-style: none; margin: 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
    .plan li { position: relative; padding-left: 22px; font-size: 0.9375rem; color: var(--ink-2); }
    .plan li::before { content: ""; position: absolute; left: 0; top: 0.7em; width: 12px; height: 1.5px; background: var(--index); }
    .fine { margin-top: 20px; }
</style>
