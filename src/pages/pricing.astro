---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import OfferTable from '../components/site/OfferTable.astro';

const details = [
    { t: 'Trigger audit, or design and feasibility', p: 'from EUR 6,000', u: 'fixed scope, about two weeks', inc: ['Independent rebuild of the index from the named data', 'Backtest over the full record, against documented losses where they exist', 'Basis-risk and data-source findings', 'Wording-to-code check', 'Written findings and a walkthrough call'], href: '/trigger-audit' },
    { t: 'Onboarding: one index', p: 'from EUR 10,000', u: 'once, per index', inc: ['Index definition written for the policy wording', 'Pipeline with an input check and a content hash at each stage', 'Backtest and basis-risk read', 'Methodology report'], href: '/method' },
    { t: 'Pipeline support and independent verification', p: 'from EUR 8,000', u: 'per year, per programme', inc: ['The pipeline runs on your servers', 'I maintain it', 'I check its results against the contract'], href: '/calculation-agent' },
    { t: 'Calculation agent', p: 'from EUR 12,000', u: 'per year, per programme', inc: ['I run the calculation on my server', 'I issue the event report the payout follows', 'Two event calculations a year included', 'Available about six weeks after signature, set up per contract'], href: '/calculation-agent' },
];
---

<Site
    title="Pricing · Skaraz Data"
    description="Published prices for an independent calculation agent: trigger audit from EUR 6,000, onboarding one index from EUR 10,000, pipeline support and independent verification from EUR 8,000 a year, calculation agent from EUR 12,000 a year."
>
    <PageHead
        label="Pricing"
        title="Published prices, so you can budget before the first call."
        lede="Prices in euros, excluding VAT, shown as a starting point. The final scope and price are fixed in writing before any work starts."
    />

    <section class="section">
        <div class="wrap">
            <OfferTable />
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal"><p class="label label--index">What each line includes</p><h2>From the first audit to the run service.</h2></div>
            <div class="grid cols-2 plans">
                {details.map((pl, i) => (
                    <div class="plan reveal" style={`--i:${i}`}>
                        <h3>{pl.t}</h3>
                        <p class="amount"><span class="num">{pl.p}</span><span class="muted small">{pl.u}</span></p>
                        <ul>{pl.inc.map(x => <li>{x}</li>)}</ul>
                        <a class="link" href={pl.href}>Details <span class="arrow" aria-hidden="true">→</span></a>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="wrap terms">
            <div class="section-head reveal"><p class="label label--index">Terms</p><h2>How the money works.</h2></div>
            <dl class="fields reveal">
                <dt>Deposit</dt><dd>30 to 50% on signature for fixed-price work.</dd>
                <dt>Exclusivity</dt><dd>Contracts are non-exclusive.</dd>
                <dt>Payout link</dt><dd>No fee is linked to the payout amount or to whether a trigger fires.</dd>
                <dt>Scope</dt><dd>Engineering and calculation, not actuarial sign-off.</dd>
                <dt>Contracting party</dt><dd>Stéphane Karasiewicz EI, trading as Skaraz Data.</dd>
            </dl>
            <p><a class="btn" href="/scope" data-umami-event="scope-pricing">Scope an audit <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
    </section>
</Site>

<style>
    .plans { align-items: stretch; }
    .plan { display: grid; grid-template-rows: auto auto 1fr auto; gap: 16px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
    .amount { display: grid; gap: 4px; }
    .amount .num { font: 400 2rem/1 var(--mono); letter-spacing: -0.02em; }
    .plan ul { list-style: none; margin: 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
    .plan li { position: relative; padding-left: 22px; font-size: 0.9375rem; }
    .plan li::before { content: ""; position: absolute; left: 0; top: 0.7em; width: 12px; height: 1.5px; background: var(--index); }
    .terms { display: grid; gap: 28px; max-width: 860px; }
    .terms .section-head { margin-bottom: 0; }
</style>
