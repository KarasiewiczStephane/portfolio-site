---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import PageHead from '../../components/site/PageHead.astro';
const posts = (await getCollection('blogs')).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Site title="Blog · climate data for parametric insurance · Skaraz Data" description="Notes on climate data, satellite sources and parametric insurance pipelines.">
    <PageHead label="Blog" title="Notes on climate data and parametric triggers." cta={false} />
    <section class="section">
        <div class="wrap">
            <ol class="posts">
                {posts.map((p, i) => (
                    <li class="reveal" style={`--i:${Math.min(i, 6)}`}>
                        <a href={`/blog/${p.slug}`}>
                            <span class="num date">{fmt(p.data.publishedDate)}</span>
                            <span class="t">{p.data.title}</span>
                            <span class="d muted">{p.data.description}</span>
                            <span class="go" aria-hidden="true">→</span>
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    </section>
</Site>

<style>
    .posts { list-style: none; margin: 0; padding: 0; }
    .posts a {
        display: grid; grid-template-columns: 140px minmax(0, 1fr) 32px; gap: 6px 24px;
        padding-block: 26px; border-top: 1px solid var(--line); text-decoration: none; color: var(--ink);
    }
    .date { font-size: 0.8125rem; color: var(--muted); padding-top: 4px; grid-row: 1 / span 2; }
    .t { font: 700 var(--step-1)/1.3 var(--display); }
    .d { grid-column: 2; font-size: 0.9375rem; max-width: 70ch; }
    .go { grid-column: 3; grid-row: 1 / span 2; align-self: center; color: var(--index); font-size: 1.25rem; transition: transform 200ms var(--ease-out); }
    @media (hover: hover) and (pointer: fine) { .posts a:hover .t { color: var(--index); } .posts a:hover .go { transform: translateX(4px); } }
    @media (max-width: 640px) { .posts a { grid-template-columns: minmax(0, 1fr); } .date, .d, .go { grid-column: 1; grid-row: auto; } .go { display: none; } }
</style>
