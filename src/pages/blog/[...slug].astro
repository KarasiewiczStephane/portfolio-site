---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blogs');
    return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const readingTime = post.data.readingTimeMinutes || Math.ceil(post.body.split(' ').length / 200);
const canonicalUrl = new URL(`blog/${post.slug}`, 'https://skarazdata.com').href;
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedDate.toISOString(),
    dateModified: (post.data.updatedDate || post.data.publishedDate).toISOString(),
    author: { '@type': 'Person', name: post.data.author, url: 'https://skarazdata.com' },
    publisher: { '@type': 'Organization', name: 'Skaraz Data', url: 'https://skarazdata.com' },
    mainEntityOfPage: canonicalUrl,
    keywords: post.data.tags.join(', '),
};
const date = post.data.publishedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Site title={`${post.data.title} · Skaraz Data`} description={post.data.description} jsonLd={jsonLd}>
    <article>
        <header class="post-head">
            <div class="wrap narrow">
                <a class="back" href="/blog">← All articles</a>
                <p class="label label--index">{date} · {readingTime} min read</p>
                <h1>{post.data.title}</h1>
                <p class="lede">{post.data.description}</p>
                <div class="tags">{post.data.tags.slice(0, 5).map(t => <span class="chip chip--plain">{t}</span>)}</div>
            </div>
        </header>
        <div class="wrap narrow body">
            <div class="prose post"><Content /></div>
            <aside class="end card">
                <p class="label label--trigger">Independent calculation agent</p>
                <p>I compute, check and document parametric triggers from satellite and climate data.</p>
                <div class="row"><a class="btn" href="/calculation-agent">See the service <span class="arrow" aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/showcase">See the calculations</a></div>
            </aside>
        </div>
    </article>
</Site>

<style>
    .narrow { max-width: 820px; }
    .post-head { padding-block: clamp(48px, 7vw, 88px) 40px; border-bottom: 1px solid var(--line); }
    .post-head .wrap { display: grid; gap: 18px; }
    .post-head h1 { font-size: clamp(2rem, 1.2rem + 2.6vw, 3rem); }
    .back { color: var(--muted); text-decoration: none; font-size: 0.875rem; }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .body { padding-block: 48px 96px; display: grid; gap: 56px; }
    .post { font-size: 1.0625rem; line-height: 1.75; }
    .post :global(img) { border-radius: var(--radius); border: 1px solid var(--line); }
    .post :global(table) { border-collapse: collapse; width: 100%; font-size: 0.9375rem; display: block; overflow-x: auto; }
    .post :global(th), .post :global(td) { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); }
    .post :global(th) { font: 500 0.75rem/1.3 var(--mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
    .post :global(strong) { color: var(--ink); }
    .end { display: grid; gap: 14px; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
