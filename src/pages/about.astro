---
import Site from '../layouts/Site.astro';

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Stéphane Karasiewicz',
    url: 'https://skarazdata.com/about',
    mainEntity: {
        '@type': 'Person',
        name: 'Stéphane Karasiewicz',
        jobTitle: 'Principal, Skaraz Data, independent calculation agent for parametric insurance',
        url: 'https://skarazdata.com',
        image: 'https://skarazdata.com/portrait.jpg',
        sameAs: [
            'https://www.linkedin.com/in/stephane-karasiewicz',
            'https://github.com/KarasiewiczStephane',
            'https://www.researchgate.net/profile/Stephane_Karasiewicz',
        ],
        alumniOf: { '@type': 'EducationalOrganization', name: 'Université de Lille' },
        address: { '@type': 'PostalAddress', addressRegion: 'Hauts-de-France', addressCountry: 'FR' },
    },
};

const timeline = [
    { y: '2014 to 2017', t: 'PhD, marine ecology, Université de Lille', d: 'Phytoplankton dynamics under global change: multivariate statistics on noisy satellite data, calibration across regions, seasonal time series, and validation against ground truth.' },
    { y: '2018 to 2023', t: 'Marine remote sensing researcher, IFREMER', d: 'MODIS, Sentinel-2 and 3, reanalysis products and in-situ networks along the French coast and beyond. Two R packages published on CRAN, and six researchers mentored on reproducible workflows.' },
    { y: 'Sep 2023', t: 'Skaraz Data', d: 'Trading name of Stéphane Karasiewicz EI, registered in France (SIRET 979 870 821).' },
    { y: '2024 to 2026', t: 'Raincoat, parametric insurtech', d: 'Embedded senior data scientist for two years. Ran the satellite and reanalysis layer for every peril except hurricane wind and earthquake, shipped Water Balance to production, built Heat Stress, and three daily-use dashboards.' },
    { y: '2026', t: 'Independent calculation agent', d: 'Five end-to-end trigger calculations on public data, published with their limits, and the service built around them.' },
];
---

<Site
    title="About Stéphane Karasiewicz · Skaraz Data"
    description="Stéphane Karasiewicz: 15+ years of satellite remote sensing, 7 publications, two years in production at a parametric insurtech. Independent calculation agent based in Hauts-de-France."
    jsonLd={jsonLd}
>
    <section class="panel on-panel ah">
        <div class="wrap ah-grid">
            <div class="ah-copy">
                <p class="label">About · principal, Skaraz Data</p>
                <h1>Stéphane Karasiewicz</h1>
                <p class="lede">I spent fifteen years learning what satellite and climate data really say, and the last few making them run in production for parametric insurers. The calculation agent role is where both meet.</p>
                <div class="facts">
                    <div><span class="label">Remote sensing</span><span class="num">15+ years</span></div>
                    <div><span class="label">Publications</span><span class="num">7 peer-reviewed</span></div>
                    <div><span class="label">Based in</span><span>Hauts-de-France</span></div>
                    <div><span class="label">Languages</span><span>French, English</span></div>
                </div>
            </div>
            <img src="/portrait.jpg" alt="Portrait of Stéphane Karasiewicz" width="320" height="320" loading="eager" class="portrait" />
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head reveal"><p class="label label--index">Path</p><h2>From satellite science to production pipelines.</h2></div>
            <ol class="tl">
                {timeline.map((e, i) => (
                    <li class="reveal" style={`--i:${i}`}><span class="num y">{e.y}</span><div><h3>{e.t}</h3><p class="muted">{e.d}</p></div></li>
                ))}
            </ol>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal"><p class="label label--index">How I work</p><h2>Three convictions.</h2></div>
            <div class="grid cols-3">
                <div class="card reveal" style="--i:0"><h3>A pipeline that needs babysitting has failed.</h3><p class="muted">A model that is 95% right and runs every night without help beats one that is 99% right and needs a person.</p></div>
                <div class="card reveal" style="--i:1"><h3>The overlap is where the work is.</h3><p class="muted">Climate science without engineering stays research. Engineering without climate science misreads the data.</p></div>
                <div class="card reveal" style="--i:2"><h3>Say where the method stops.</h3><p class="muted">Every calculation I publish lists its limits. A number without them is not finished.</p></div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <div class="section-head reveal"><p class="label label--index">What people say</p><h2>From the teams I worked with.</h2></div>
            <div class="grid cols-3 quotes">
                <figure class="reveal" style="--i:0"><blockquote>“Steph is a seriously talented engineer with a rare combination of skills.”</blockquote><figcaption><strong>Jan Paral</strong><span class="muted">Head of R&amp;D and Co-Founder, Raincoat</span></figcaption></figure>
                <figure class="reveal" style="--i:1"><blockquote>“His coding skills are unparalleled, producing efficient and well-documented codes. His ability to translate our needs is exemplary.”</blockquote><figcaption><strong>Kelig Mahé</strong><span class="muted">Head of Unit, Fisheries Resources, Channel and North Sea, IFREMER</span></figcaption></figure>
                <figure class="reveal" style="--i:2"><blockquote>“He always takes time to explain, and never loses his sense of humor even after the nth error message.”</blockquote><figcaption><strong>Carolin Neven</strong><span class="muted">PhD student, IFREMER</span></figcaption></figure>
            </div>
            <div class="row">
                <a class="btn" href="/scope" data-umami-event="scope-about">Start with your trigger <span class="arrow" aria-hidden="true">→</span></a>
                <a class="btn btn--ghost" href="https://calendly.com/skaraz_data/15-minute-meeting" target="_blank" rel="noopener noreferrer">Book a 15-minute call</a>
                <a class="btn btn--ghost" href="/cv">Read the CV</a>
            </div>
        </div>
    </section>
</Site>

<style>
    .ah { padding-block: clamp(48px, 7vw, 96px); }
    .ah-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
    .ah-copy { display: grid; gap: 20px; }
    .ah { border-bottom: 1px solid var(--line); }
    .ah .lede { color: var(--muted); }
    .portrait { width: 100%; max-width: 320px; aspect-ratio: 1; object-fit: cover; border-radius: 10px; border: 1px solid var(--panel-line); filter: grayscale(0.15); justify-self: end; }
    .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; padding-top: 20px; border-top: 1px solid var(--panel-line); }
    .facts > div { display: grid; gap: 4px; min-width: 0; }
    @media (max-width: 860px) { .ah-grid { grid-template-columns: minmax(0, 1fr); } .portrait { justify-self: start; max-width: 220px; } .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .tl { list-style: none; margin: 0; padding: 0; }
    .tl li { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); }
    .tl li div { display: grid; gap: 6px; }
    .y { font-size: 0.875rem; color: var(--index); font-weight: 500; padding-top: 3px; }
    @media (max-width: 560px) { .tl li { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
    .card { display: grid; gap: 10px; align-content: start; }
    .quotes figure { margin: 0; display: grid; gap: 16px; align-content: start; padding-top: 18px; border-top: 1px solid var(--ink); }
    .quotes blockquote { margin: 0; font: 400 1.1875rem/1.45 var(--display); letter-spacing: -0.01em; }
    .quotes strong { font-weight: 500; }
    .quotes figcaption { display: grid; gap: 2px; font-size: 0.875rem; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; }
</style>
