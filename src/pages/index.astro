---
import Site from '../layouts/Site.astro';
import TriggerChart from '../components/site/TriggerChart.astro';
import PipelineFlow from '../components/site/PipelineFlow.astro';
import Audience from '../components/site/Audience.astro';
import PocCard from '../components/site/PocCard.astro';
import LivingMark from '../components/site/LivingMark.astro';
import OfferTable from '../components/site/OfferTable.astro';
import { getPocs, coralMark } from '../lib/pocs';

const pocs = getPocs();
const hero = pocs[0]; // La Réunion, Saint-Leu
// Same seasons and cell size as the brochure and the design system example.
const mark = coralMark('coral_reunion', 'La Réunion', 2.5, 2014, 2019);

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'ProfessionalService',
            name: 'Skaraz Data',
            legalName: 'Stéphane Karasiewicz EI',
            url: 'https://skarazdata.com',
            description: 'Independent calculation agent for parametric insurance. Defines, builds and independently checks the index a parametric policy pays on.',
            areaServed: 'Worldwide',
            address: { '@type': 'PostalAddress', addressRegion: 'Hauts-de-France', addressCountry: 'FR' },
            founder: { '@type': 'Person', name: 'Stéphane Karasiewicz' },
        },
    ],
};

const names = ['Calculation agent', 'Settlement services', 'Independent third party', 'Trigger verification'];

const steps = [
    { n: '1', k: 'Define', t: 'An index you can write a policy on', d: 'Trigger, data source, fallback and calculation written so they fit the policy wording.' },
    { n: '2', k: 'Build', t: 'A pipeline on public data', d: 'Input checks and a content hash at every stage, so the calculation can be rerun and checked.' },
    { n: '3', k: 'Test', t: 'Backtest and basis risk', d: 'Against documented losses where they exist; where no loss record exists, I say so.' },
    { n: '4', k: 'Calculate', t: 'The event report', d: 'Index value, tier, payout, sources, dataset versions and hashes, on time.' },
];
---

<Site
    title="Skaraz Data · Independent calculation agent for parametric insurance"
    description="Skaraz Data, independent calculation agent. I define, build and independently check the index a parametric policy pays on, from public satellite and reanalysis data. Prices published, from EUR 6,000."
    alt="/fr"
    jsonLd={jsonLd}
>
    <!-- HERO -->
    <section class="hero">
        <div class="wrap">
            <div class="hero-top">
                <div class="hero-copy">
                    <p class="label">Skaraz Data · independent calculation agent</p>
                    <h1>The index your policy pays on, <em>calculated</em> by someone with nothing to sell you.</h1>
                    <p class="lede">I define, build and independently check the index a parametric policy pays on, from public satellite and reanalysis data. Every number traces to a dataset, a version and a hash.</p>
                    <div class="ctas">
                        <a class="btn" href="/scope" data-umami-event="scope-hero">Start with your trigger <span class="arrow" aria-hidden="true">→</span></a>
                        <a class="btn btn--ghost" href="/showcase">See the calculations</a>
                    </div>
                    <p class="principal small muted">Stéphane Karasiewicz, principal. Engineering and calculation, not actuarial sign-off.</p>
                </div>
                <LivingMark mark={mark} size={176} class="hero-mark" />
            </div>

            <div class="hero-chart">
                <div class="spec">
                    <div><span class="label">Index</span><span>Degree Heating Weeks</span></div>
                    <div><span class="label">Source</span><span>NOAA Coral Reef Watch, 5 km</span></div>
                    <div><span class="label">Place</span><span>Saint-Leu, La Réunion</span></div>
                    <div><span class="label">Backtest</span><span class="num">2009 to 2024</span></div>
                </div>
                <TriggerChart series={hero.series} variant="panel" height={300} />
                <p class="poc-note small">Proof of concept on public data, not a live policy. Hover the chart to read any week. <a href={`/showcase/${hero.slug}`}>Read the full calculation report →</a></p>
            </div>
        </div>
    </section>

    <!-- NAMES -->
    <section class="names">
        <div class="wrap names-row">
            <p class="label">Contracts call this role</p>
            <ul>{names.map(n => <li>{n}</li>)}</ul>
        </div>
    </section>

    <!-- FOUR STEPS -->
    <section class="section">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">What I do</p>
                <h2>Define, build, test, calculate.</h2>
            </div>
            <ol class="steps grid cols-4">
                {steps.map((s, i) => (
                    <li class="reveal" style={`--i:${i}`}>
                        <p class="label">{s.n} · {s.k}</p>
                        <h3>{s.t}</h3>
                        <p class="muted">{s.d}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- INDEPENDENCE -->
    <section class="section section--tint">
        <div class="wrap indep">
            <div class="section-head reveal">
                <p class="label label--index">Why independent</p>
                <h2>Most triggers are calculated by the party that sells the product or carries the risk.</h2>
            </div>
            <ul class="indep-list reveal">
                <li><strong>No risk carried.</strong> Skaraz Data is a calculation and engineering provider, never an insurer or an MGA.</li>
                <li><strong>Nothing else to sell.</strong> No product, no data resale, no fee linked to the payout amount.</li>
                <li><strong>Method on the table.</strong> Every report states its sources, versions and limits.</li>
                <li><strong>Engineering and calculation,</strong> not actuarial sign-off.</li>
            </ul>
        </div>
    </section>

    <!-- AUDIENCE -->
    <section class="section">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">Who it is for</p>
                <h2>Pick the seat you sit in.</h2>
            </div>
            <div class="reveal"><Audience /></div>
        </div>
    </section>

    <!-- OFFER -->
    <section class="section section--tint">
        <div class="wrap price-wrap">
            <div class="section-head reveal">
                <p class="label label--index">Offer</p>
                <h2>Published prices, so you can budget before the first call.</h2>
                <p class="lede">Most work starts with a fixed-price audit or a short paid scoping. The run services follow once an index exists.</p>
            </div>
            <div class="reveal"><OfferTable /></div>
            <p><a class="link" href="/pricing">What each line includes <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <!-- SHOWCASE -->
    <section class="section">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">Showcase</p>
                <h2>Five calculations on public data, limits named.</h2>
                <p class="lede">Each one runs the full chain: data, checks, index, trigger, payout, audit trail. They are proofs of concept, not live policies, and every report says where the method stops.</p>
            </div>
            <div class="grid cols-3 pocs">
                {pocs.map((p, i) => <div class="reveal" style={`--i:${i}`}><PocCard poc={p} /></div>)}
                <a class="map-card reveal" style="--i:5" href="/constellation/">
                    <span class="label">Live map</span>
                    <h3>Open all five on the interactive map</h3>
                    <p class="muted small">Hazard rasters, payout choropleths and per-cell time series, in the browser.</p>
                    <span class="link">Open the map <span class="arrow" aria-hidden="true">→</span></span>
                </a>
            </div>
            <p class="small muted note">Rainfall indices: CHIRPS v2 production ends after December 2026; new work uses CHIRPS v3.</p>
        </div>
    </section>

    <!-- METHOD + CONTINUITY -->
    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">Method</p>
                <h2>Six steps, the same every time, all of it written down.</h2>
                <p class="lede">The method is open: every report shows its sources, dataset versions and hashes, so a counterparty can check each step.</p>
            </div>
            <PipelineFlow />
            <div class="continuity reveal">
                <div>
                    <p class="label">Continuity, as it stands today</p>
                    <h3>What exists, and what is set up per contract.</h3>
                </div>
                <ul class="ticks">
                    <li>A documented method, the same for every calculation.</li>
                    <li>An input check and a content hash at each stage of the pipeline.</li>
                    <li>Reports that can be rerun from their stated inputs and code version.</li>
                    <li>Hosted calculation is set up per contract, about six weeks after signature.</li>
                </ul>
            </div>
            <p class="method-link"><a class="link" href="/method">Read the full method <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <!-- PROOF -->
    <section class="section">
        <div class="wrap proof">
            <div class="section-head reveal">
                <p class="label label--index">Who calculates</p>
                <h2>Two years inside a parametric insurtech’s production pipelines.</h2>
                <p class="lede">Senior data scientist at Raincoat, a parametric insurtech, from February 2024 to January 2026. I ran the satellite and reanalysis data layer for every peril except hurricane wind and earthquake.</p>
            </div>
            <div class="grid cols-4 stats">
                <div class="metric reveal" style="--i:0"><span class="value">4</span><span class="note">perils worked on: drought and precipitation in production, water balance built to production, heat stress built (not shipped).</span></div>
                <div class="metric reveal" style="--i:1"><span class="value">3</span><span class="note">dashboards used by risk and underwriting: Precipitation, Water Balance, Drought.</span></div>
                <div class="metric reveal" style="--i:2"><span class="value">10+</span><span class="note">countries across Latin America, the Caribbean and Africa.</span></div>
                <div class="metric reveal" style="--i:3"><span class="value">15+</span><span class="note">years of satellite remote sensing, 7 peer-reviewed publications, PhD in marine ecology.</span></div>
            </div>
            <figure class="quote reveal">
                <blockquote>“You could hand him a complex project and trust him to run with it, communicate clearly along the way, and deliver something that genuinely moved the needle for the company.”</blockquote>
                <figcaption><strong>Jan Paral</strong> · Head of R&amp;D and Co-Founder, Raincoat</figcaption>
            </figure>
            <p><a class="link" href="/projects/case-study-raincoat">Read the Raincoat case study <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta">
        <div class="wrap cta-row">
            <div>
                <h2>Start with your trigger.</h2>
                <p class="lede">Send the peril, region, data you use and your deadline. You get a fixed scope and price before any commitment.</p>
            </div>
            <div class="ctas">
                <a class="btn" href="/scope" data-umami-event="scope-footer-cta">Describe your trigger <span class="arrow" aria-hidden="true">→</span></a>
                <a class="btn btn--ghost" href="https://calendly.com/skaraz_data/15-minute-meeting" target="_blank" rel="noopener noreferrer" data-umami-event="book-call-footer-cta">Book a 15-minute call</a>
            </div>
        </div>
    </section>
</Site>

<style>
    .hero { padding-block: clamp(48px, 7vw, 96px) clamp(40px, 5vw, 64px); }
    .hero-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(28px, 6vw, 96px); align-items: start; }
    .hero-copy { display: grid; gap: 24px; max-width: 760px; }
    .hero h1 { max-width: 17ch; }
    .hero h1 em { font-style: normal; color: var(--trigger); }
    .hero .lede { max-width: 54ch; }
    .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
    .principal { margin-top: -4px; }
    .hero-top :global(.hero-mark) { padding-top: 8px; }
    .hero-chart { margin-top: clamp(40px, 6vw, 72px); padding: clamp(18px, 2.5vw, 28px); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); display: grid; gap: 18px; }
    .spec { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
    .spec > div { display: grid; gap: 4px; min-width: 0; font-size: 0.9375rem; }
    .poc-note { color: var(--muted); }
    .poc-note a { color: var(--index); }
    @media (max-width: 900px) {
        .hero-top { grid-template-columns: minmax(0, 1fr); }
        .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    :global(.js) .hero-copy > *, :global(.js) .hero-top > :global(.hero-mark) { animation: rise 700ms var(--ease-out) both; }
    :global(.js) .hero-copy h1 { animation-delay: 60ms; }
    :global(.js) .hero-copy > :nth-child(3) { animation-delay: 120ms; }
    :global(.js) .hero-copy > :nth-child(n+4) { animation-delay: 180ms; }
    :global(.js) .hero-chart { animation: rise 800ms var(--ease-out) 240ms both; }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
        :global(.js) .hero-copy > *, :global(.js) .hero-top > :global(.hero-mark), :global(.js) .hero-chart { animation: fade 300ms ease both; }
        @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    }

    .names { border-block: 1px solid var(--line); }
    .names-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-block: 20px; }
    .names ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; }
    .names li { font-size: 0.9375rem; color: var(--ink); }
    .names li + li::before { content: "·"; margin-right: 22px; color: var(--muted); }
    @media (max-width: 640px) {
        .names ul { gap: 8px; }
        .names li { padding: 6px 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); font-size: 0.875rem; }
        .names li + li::before { content: none; }
    }

    .steps { list-style: none; margin: 0; padding: 0; }
    .steps li { display: grid; gap: 10px; align-content: start; padding-top: 14px; border-top: 1px solid var(--ink); }
    .steps h3 { font-size: 1.1875rem; }

    .indep { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
    .indep .section-head { margin-bottom: 0; }
    .indep-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .indep-list li { padding-block: 14px; border-bottom: 1px solid var(--line); color: var(--muted); }
    .indep-list strong { font-weight: 500; color: var(--ink); }
    @media (max-width: 860px) { .indep { grid-template-columns: minmax(0, 1fr); } }

    .price-wrap { display: grid; gap: 24px; }
    .price-wrap .section-head { margin-bottom: 0; }

    .pocs { align-items: stretch; }
    .pocs > div { display: grid; }
    .note { margin-top: 16px; }
    .map-card {
        display: grid; gap: 12px; align-content: start; padding: 22px; border-radius: var(--radius);
        border: 1px dashed var(--line-strong); text-decoration: none; color: var(--ink);
        transition: border-color 200ms ease;
    }
    @media (hover: hover) and (pointer: fine) { .map-card:hover { border-color: var(--ink); } }

    .continuity { margin-top: clamp(40px, 6vw, 64px); padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 32px; }
    .continuity > div { display: grid; gap: 10px; align-content: start; }
    .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ticks li { position: relative; padding-left: 22px; }
    .ticks li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 12px; height: 1.5px; background: var(--index); }
    @media (max-width: 860px) { .continuity { grid-template-columns: minmax(0, 1fr); } }
    .method-link { margin-top: 32px; }

    .proof { display: grid; gap: 40px; }
    .proof .section-head { margin-bottom: 0; }
    .stats .value { font-size: clamp(2.5rem, 1.6rem + 2.4vw, 3.5rem); }
    .quote { margin: 0; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: grid; gap: 16px; }
    .quote blockquote { margin: 0; font: 400 var(--step-2)/1.4 var(--display); letter-spacing: -0.02em; max-width: 46ch; }
    .quote figcaption { color: var(--muted); font-size: 0.9375rem; }
    .quote strong { font-weight: 500; color: var(--ink); }

    .cta { padding-block: clamp(56px, 8vw, 96px); border-top: 1px solid var(--line); }
    .cta-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 32px; }
    .cta-row > div:first-child { display: grid; gap: 14px; }
</style>
