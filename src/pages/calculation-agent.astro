---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import PipelineFlow from '../components/site/PipelineFlow.astro';
import TriggerChart from '../components/site/TriggerChart.astro';
import { getPocs } from '../lib/pocs';
const mayotte = getPocs()[1];
---

<Site
    title="Calculation agent for parametric insurance · Skaraz Data"
    description="Independent calculation agent for parametric insurance: index computed from named data, trigger tested, payout report issued, audit trail kept. Binding or verifying role."
    alt="/fr/agent-de-calcul"
>
    <PageHead
        label="Service · calculation agent"
        title="I compute the index, test the trigger and sign the payout report."
        lede="The calculation agent is the party that turns named data into a payout decision. Contracts call it the calculation agent, the independent third party, settlement services or trigger verification. It is the same job."
    >
        <a slot="cta" class="btn btn--ghost" href="/pricing">See prices</a>
    </PageHead>

    <section class="section">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">Two roles</p>
                <h2>Binding agent, or the one who checks it.</h2>
            </div>
            <div class="grid cols-2">
                <div class="card role reveal" style="--i:0">
                    <p class="label label--trigger">Binding agent</p>
                    <h3>My result is the one the contract pays on.</h3>
                    <ul class="ticks">
                        <li>Monitoring through the risk season, with the fallback source agreed in advance</li>
                        <li>Event calculation and payout report within the contract’s deadline</li>
                        <li>Two event calculations a year included</li>
                        <li>Season-end report and the full audit trail</li>
                    </ul>
                    <p class="price num">from EUR 12,000 / year per programme · onboarding from EUR 8,000</p>
                </div>
                <div class="card role reveal" style="--i:1">
                    <p class="label label--trigger">Verifying or backup agent</p>
                    <h3>I rerun the calculation and tell you whether it holds.</h3>
                    <ul class="ticks">
                        <li>Shadow calculation from the same named data, independently coded</li>
                        <li>Written reconciliation when the two results differ</li>
                        <li>Ready to take over if the primary calculator cannot deliver</li>
                        <li>Suited to donors, reinsurers and programme boards</li>
                    </ul>
                    <p class="price num">from EUR 6,000 / year per programme</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">How it runs</p>
                <h2>The same six steps for every programme.</h2>
            </div>
            <PipelineFlow />
        </div>
    </section>

    <section class="section">
        <div class="wrap two">
            <div class="stack reveal" style="--stack:1.1rem">
                <p class="label label--index">What you receive after an event</p>
                <h2>A payout report anyone can rerun.</h2>
                <p class="lede">One page per event, with the evidence behind it. Below is the shape of it, filled with the Mayotte backtest.</p>
                <dl class="fields">
                    <dt>Programme</dt><dd>Mayotte barrier reef, bleaching cover (proof of concept)</dd>
                    <dt>Index</dt><dd>Degree Heating Weeks, sector maximum over the season</dd>
                    <dt>Source</dt><dd>NOAA Coral Reef Watch 5 km, CoralTemp</dd>
                    <dt>Ladder</dt><dd class="num">3.0 / 6.0 / 9.0 °C-weeks → 25 / 60 / 100%</dd>
                    <dt>Result</dt><dd>Eastern barrier, 2024: tier 3, full limit</dd>
                    <dt>Backtest</dt><dd>Caught 2010, 2016 and 2024, the three documented bleaching years, with no false positives over 16 seasons</dd>
                    <dt>Evidence</dt><dd>Input file hashes, code version, run log</dd>
                </dl>
                <p><a class="link" href={`/showcase/${mayotte.slug}`}>Open the full Mayotte report <span class="arrow" aria-hidden="true">→</span></a></p>
            </div>
            <div class="reveal" style="--i:1">
                <TriggerChart series={mayotte.series} height={320} />
            </div>
        </div>
    </section>

    <section class="section section--tint">
        <div class="wrap">
            <div class="section-head reveal">
                <p class="label label--index">Questions buyers ask</p>
                <h2>What happens if you are not available on payout day?</h2>
            </div>
            <div class="grid cols-2 faq">
                <div class="reveal" style="--i:0"><h3>Continuity</h3><p class="muted">You hold the code, the input hashes and a written runbook from day one. Any qualified analyst can rerun a calculation from them. For binding roles we agree the backup arrangement in the contract before the season starts.</p></div>
                <div class="reveal" style="--i:1"><h3>Independence</h3><p class="muted">I write no cover, hold no risk capacity and take no fee linked to the payout amount. If I have worked on a product’s design, I say so before taking the agent role on it.</p></div>
                <div class="reveal" style="--i:2"><h3>Data rights</h3><p class="muted">Public sources such as ERA5, CHIRPS and NOAA allow this use. Commercial data, such as some SAR imagery, needs its licence checked for payout use. I do that before the contract, not after the event.</p></div>
                <div class="reveal" style="--i:3"><h3>What it is not</h3><p class="muted">This is not actuarial sign-off and not pricing. I compute and document the index; pricing stays with your actuaries and underwriters.</p></div>
            </div>
        </div>
    </section>
</Site>

<style>
    .role { display: grid; gap: 14px; align-content: start; }
    .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ticks li { position: relative; padding-left: 22px; color: var(--ink-2); }
    .ticks li::before { content: ""; position: absolute; left: 0; top: 0.7em; width: 12px; height: 1.5px; background: var(--index); }
    .price { padding-top: 14px; border-top: 1px dashed var(--line-strong); font-size: 0.875rem; font-weight: 500; }
    .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
    .two > * { min-width: 0; }
    @media (max-width: 900px) { .two { grid-template-columns: minmax(0, 1fr); } }
    .faq > div { display: grid; gap: 10px; align-content: start; }
</style>
