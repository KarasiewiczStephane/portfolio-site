---
import TriggerChart from './TriggerChart.astro';
import type { Poc } from '../../lib/pocs';
interface Props { poc: Poc; lang?: 'en' | 'fr' }
const { poc, lang = 'en' } = Astro.props;
const fr = lang === 'fr';
const m = poc.metrics[0];
---

<a class="poc" href={`/showcase/${poc.slug}`}>
    <div class="top">
        <span class="label">{poc.perilLabel}</span>
        <span class:list={['chip', poc.backtest.status === 'scored' ? '' : 'chip--plain']}>
            {poc.backtest.status === 'scored' ? (fr ? 'backtest noté' : 'backtest scored') : (fr ? 'non noté sur pertes' : 'not scored on losses')}
        </span>
    </div>
    <h3>{poc.place}</h3>
    <div class="chart"><TriggerChart series={poc.series} compact height={84} showCaption={false} lang={lang} /></div>
    <div class="foot">
        <div><span class="value num">{m.value}</span><span class="muted small">{m.label}</span></div>
        <span class="go" aria-hidden="true">→</span>
    </div>
    <p class="src small muted">{poc.source}</p>
</a>

<style>
    .poc {
        display: grid; gap: 14px; align-content: start; min-width: 0;
        padding: 22px; border: 1px solid var(--line); border-radius: var(--radius);
        background: var(--surface); text-decoration: none; color: var(--ink);
        transition: border-color 200ms ease, transform 160ms var(--ease-out);
    }
    .poc:active { transform: scale(0.99); }
    .top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    h3 { font-size: var(--step-2); }
    .chart { margin-inline: -4px; }
    .foot { display: flex; justify-content: space-between; align-items: end; gap: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
    .foot > div { display: grid; gap: 2px; }
    .value { font: 600 1.375rem/1 var(--display); }
    .go { font-size: 1.25rem; color: var(--index); transition: transform 200ms var(--ease-out); }
    @media (hover: hover) and (pointer: fine) {
        .poc:hover { border-color: var(--ink); }
        .poc:hover .go { transform: translateX(4px); }
    }
</style>
